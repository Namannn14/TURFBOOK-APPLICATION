<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TurfBook">

        <!-- Splash Activity (Launcher) -->
        <activity
            android:name="com.example.turfbook.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TurfBook">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication -->
        <activity
            android:name="com.example.turfbook.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.turfbook.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Home & Search -->
        <activity
            android:name="com.example.turfbook.HomeActivity"
            android:exported="false" />

        <activity
            android:name="com.example.turfbook.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Venue & Booking Flow -->
        <activity
            android:name="com.example.turfbook.VenueDetailsActivity"
            android:exported="false" />

        <activity
            android:name="com.example.turfbook.BookingActivity"
            android:exported="false" />

        <activity
            android:name="com.example.turfbook.BookingConfirmationActivity"
            android:exported="false" />

        <!-- Bookings & Favorites -->
        <activity
            android:name="com.example.turfbook.BookingsActivity"
            android:exported="false" />

        <activity
            android:name="com.example.turfbook.FavoritesActivity"
            android:exported="false" />

        <!-- Profile & Settings -->
        <activity
            android:name="com.example.turfbook.ProfileActivity"
            android:exported="false" />

        <activity
            android:name="com.example.turfbook.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
